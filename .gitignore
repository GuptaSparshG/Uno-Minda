# ════════════════════════════════════════════════════════════════
# Top-level .gitignore for the uno-minda monorepo
# (minda-sor-rag = backend API, minda-ui = demo frontend)
# ════════════════════════════════════════════════════════════════

# ───────── Secrets — NEVER commit ─────────
.env
.env.local
.env.*.local
*.env
!.env.example
*.pem
*.key

# ───────── Python virtualenv (huge, machine-specific) ─────────
minda-env/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ───────── Node / Vite ─────────
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────── Runtime / user data (regenerated on demand) ─────────
minda-sor-rag/storage/uploads/
minda-sor-rag/storage/results/
minda-sor-rag/storage/exports/
minda-sor-rag/storage/chroma_data/
!minda-sor-rag/storage/uploads/.gitkeep
!minda-sor-rag/storage/results/.gitkeep
!minda-sor-rag/storage/exports/.gitkeep
!minda-sor-rag/storage/chroma_data/.gitkeep

# ───────── Source PDFs / test fixtures (often private) ─────────
*.pdf
!docs/**/*.pdf
HVAC-Panel-SOR.pdf

# ───────── Exports / artifacts at top level ─────────
*.xlsx
*.csv
analysis.json
out.json
results.json
report.*
/tmp/

# ───────── OS / IDE ─────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/

# ───────── Local Claude memory / scratch ─────────
.claude/
SPEC.md.bak

# ───────── Docling cache (downloaded model weights) ─────────
~/.cache/docling/

# ───────── If you ever build a wheel/dist ─────────
build/
*.tar.gz
*.whl
