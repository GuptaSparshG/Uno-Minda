# ════════════════════════════════════════════════════════════════
# SOR Analyzer configuration
# Pick ONE preset below (uncomment), or mix-and-match.
# ════════════════════════════════════════════════════════════════

# ───────── LLM ─────────
# Provider is always "openai" — we use the OpenAI SDK and point it at
# any OpenAI-compatible endpoint via LLM_BASE_URL.
LLM_PROVIDER=openai
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ───────── Embeddings ─────────
# openai                — calls an OpenAI-compatible /v1/embeddings endpoint
# sentence_transformers — runs locally on CPU, no network, no API key
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ───────── Vector DB ─────────
# chroma   — embedded, local, persists to CHROMA_DIR
# pinecone — cloud, serverless, requires PINECONE_API_KEY
VECTOR_DB=chroma
RETRIEVAL_TOP_K=3

# Chroma
CHROMA_DIR=storage/chroma_data
CHROMA_COLLECTION=incose_iso_rules

# Pinecone (only used when VECTOR_DB=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=sor-incose-iso
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Must match the dimension of your embedding model:
#   text-embedding-3-small  → 1536
#   text-embedding-3-large  → 3072
#   all-MiniLM-L6-v2        → 384
PINECONE_DIMENSION=1536

# ───────── Server ─────────
HOST=0.0.0.0
PORT=8000

# ───────── Pipeline ─────────
MAX_PDF_SIZE_MB=50
BATCH_SIZE=10

# ════════════════════════════════════════════════════════════════
# PRESETS — copy a block into your .env to switch providers
# ════════════════════════════════════════════════════════════════
#
# ▸ OpenAI cloud + Chroma local (default — what you have above)
#
# ▸ Ollama local (fully self-hosted, free)
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=ollama
#     LLM_MODEL=llama3.1
#     EMBEDDING_PROVIDER=sentence_transformers
#     EMBEDDING_MODEL=all-MiniLM-L6-v2
#     VECTOR_DB=chroma
#
# ▸ OpenAI cloud + Pinecone cloud
#     VECTOR_DB=pinecone
#     PINECONE_API_KEY=pcsk-...
#     PINECONE_INDEX=sor-incose-iso
#     PINECONE_DIMENSION=1536
#
# ▸ vLLM / LM Studio self-hosted
#     LLM_BASE_URL=http://localhost:8000/v1
#     LLM_API_KEY=anything
#     LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# ▸ OpenRouter (any model, single key)
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_API_KEY=sk-or-...
#     LLM_MODEL=anthropic/claude-3.5-sonnet
